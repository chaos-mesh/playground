{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "kind": "PodChaos",
  "metadata": {
    "name": "pod-pod-kill",
    "namespace": "playground-demo",
    "labels": {
      "app.kubernetes.io/managed-by": "playground-runner"
    },
    "annotations": {
      "playground.chaos-mesh.org/title": "Pod kill · once"
    }
  },
  "spec": {
    "action": "pod-kill",
    "mode": "all",
    "selector": {
      "namespaces": [
        "playground-demo"
      ],
      "labelSelectors": {
        "app": "playground-podinfo"
      }
    }
  }
}
