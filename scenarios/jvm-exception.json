{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "kind": "JVMChaos",
  "metadata": {
    "name": "jvm-exception",
    "namespace": "playground-demo",
    "labels": {
      "app.kubernetes.io/managed-by": "playground-runner"
    },
    "annotations": {
      "playground.chaos-mesh.org/title": "Method exception · IllegalStateException"
    }
  },
  "spec": {
    "mode": "one",
    "duration": "30s",
    "selector": {
      "namespaces": [
        "playground-demo"
      ],
      "labelSelectors": {
        "app": "playground-jvm-probe"
      }
    },
    "containerNames": [
      "probe"
    ],
    "action": "exception",
    "class": "playground.JvmProbe",
    "method": "probeValue",
    "exception": "java.lang.IllegalStateException(\"playground injected exception\")"
  }
}
