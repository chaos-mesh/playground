{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "kind": "HTTPChaos",
  "metadata": {
    "name": "http-patch",
    "namespace": "playground-demo",
    "labels": {
      "app.kubernetes.io/managed-by": "playground-runner"
    },
    "annotations": {
      "playground.chaos-mesh.org/title": "Patch response header"
    }
  },
  "spec": {
    "mode": "all",
    "duration": "30s",
    "selector": {
      "namespaces": [
        "playground-demo"
      ],
      "labelSelectors": {
        "app": "playground-podinfo"
      }
    },
    "port": 9898,
    "path": "/api/info",
    "target": "Response",
    "patch": {
      "headers": [
        [
          "X-Playground-Chaos",
          "patched"
        ]
      ]
    }
  }
}
