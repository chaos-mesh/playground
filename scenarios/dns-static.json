{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "kind": "DNSChaos",
  "metadata": {
    "name": "dns-static",
    "namespace": "playground-demo",
    "labels": {
      "app.kubernetes.io/managed-by": "playground-runner"
    },
    "annotations": {
      "playground.chaos-mesh.org/title": "Static DNS answer · 192.0.2.42"
    }
  },
  "spec": {
    "mode": "all",
    "duration": "30s",
    "selector": {
      "namespaces": [
        "playground-demo"
      ],
      "labelSelectors": {
        "app": "playground-dns-probe"
      }
    },
    "patterns": [
      "podinfo.playground-demo.svc.cluster.local"
    ],
    "action": "static",
    "domainIpMapping": [
      "podinfo.playground-demo.svc.cluster.local=192.0.2.42"
    ]
  }
}
